# ============================================================
# HomeServe AI — Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to version control
# ============================================================

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ----- Razorpay -----
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ----- Resend (Email) -----
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@homeserveai.com
RESEND_FROM_NAME=HomeServe AI

# ----- Twilio (SMS / WhatsApp) -----
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HomeServe AI

# ----- Scheduled jobs -----
# Bearer token Vercel Cron sends to /api/cron/memberships (membership rollover + reminders).
# Generate any long random string; the route rejects requests without it.
CRON_SECRET=generate_a_long_random_string

# ----- Auth -----
# Secret for signed cookies / JWT (min 32 chars)
AUTH_SECRET=your_super_secret_32_char_minimum_string_here
